// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  courses            Course[]
  enrollment         Enrollment[]
  lessonProgress     LessonProgress[]
  lessonCellProgress LessonCellProgress[]
  codeSubmissions    CodeSubmission[]
  learningHeartbeats LearningActivityHeartbeat[]
  dailyLearning      StudentDailyActivity[]
  contactMessages    ContactMessage[]
  lessonComments     LessonComment[]
  commentLikes       LessonCommentLike[]
  courseReviews      CourseReview[]
  wishlistItems      WishlistItem[]
  certificates       Certificate[]
  instructorCourses  CourseInstructor[]
  organizationMemberships OrganizationMembership[]
  sentOrganizationInvitations OrganizationInvitation[] @relation("OrganizationInvitationCreator")
  quizAttempts       QuizAttempt[]
  feedbackGiven      SubmissionFeedback[] @relation("FeedbackReviewer")
  learningCursors    LearningCursor[]
  notifications      StudentNotification[]
  sentInvitations    CourseInvitation[] @relation("InvitationCreator")

  activities Activity[]

  stripeCustomerId String? @unique

  showCertificatesPublicly Boolean @default(true)

  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  @@unique([email])
  @@index([createdAt])
  @@map("user")
}

enum ActorType {
  ADMIN
  SYSTEM
}

enum ActivityAction {
  COURSE_CREATED
  COURSE_UPDATED
  COURSE_STATUS_CHANGED
  COURSE_DELETED
  CHAPTER_CREATED
  CHAPTER_UPDATED
  CHAPTER_DELETED
  LESSON_CREATED
  LESSON_UPDATED
  LESSON_DELETED
  QUIZ_CREATED
  QUIZ_UPDATED
  REVIEW_DELETED
  CONTACT_MESSAGE_DELETED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DELETED
}

enum ActivityEntityType {
  COURSE
  CHAPTER
  LESSON
  QUIZ
  REVIEW
  CONTACT_MESSAGE
  CATEGORY
}

model Activity {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  actorType         ActorType
  actorId           String?
  actor             User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorNameSnapshot String?

  action      ActivityAction
  entityType  ActivityEntityType
  entityId    String?
  entityLabel String?
  metadata    Json?

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@map("activity")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  issuer                String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@index([issuer, accountId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Course {
  id String @id @default(cuid())

  title       String
  description String?
  smallDesc   String

  fileKey    String?
  priceCents Int // price in integer cents
  duration   Int // duration in minutes
  level      CourseLevel @default(BEGINNER)

  slug   String
  status CourseStatus @default(DRAFT)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade) // if the user is deleted, their courses are deleted too
  userId String

  instructors CourseInstructor[]
  invitations CourseInvitation[]
  learningCursors LearningCursor[]
  notifications StudentNotification[]

  courseChapters CourseChapter[]
  enrollment     Enrollment[]
  courseReviews  CourseReview[]
  wishlistItems  WishlistItem[]
  certificates   Certificate[]
  categories     Category[]      @relation("CourseCategories")

  stripePriceId String? @unique

  @@unique([organizationId, slug])
  @@index([organizationId, createdAt])
}

enum OrganizationRole {
  OWNER
  ADMIN
  TEACHER
  STUDENT
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  logoUrl      String?
  primaryColor String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships OrganizationMembership[]
  invitations OrganizationInvitation[]
  courses     Course[]

  @@map("organization")
}

model OrganizationMembership {
  organizationId String
  userId         String
  role           OrganizationRole @default(STUDENT)
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId, role])
  @@map("organization_membership")
}

model OrganizationInvitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           OrganizationRole
  tokenHash      String   @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())
  createdById    String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User @relation("OrganizationInvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@index([expiresAt])
  @@map("organization_invitation")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses Course[] @relation("CourseCategories")

  @@map("category")
}

model CourseChapter {
  id String @id @default(cuid())

  title    String
  position Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String

  lessons Lesson[]

  @@unique([courseId, position])
}

model CourseInstructor {
  courseId String
  userId String
  createdAt DateTime @default(now())
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([courseId, userId])
  @@index([userId])
  @@map("course_instructor")
}

model Lesson {
  id String @id @default(cuid())

  title       String
  description String?
  videoKey    String?

  position Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapter   CourseChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chapterId String

  lessonProgress LessonProgress[]
  comments       LessonComment[]
  quiz           Quiz?
  cells          LessonCell[]

  @@unique([chapterId, position])
}

enum LessonCellType {
  TEXT
  CODE_TASK
  QUIZ
}

enum LessonCellStatus {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  PASSED
}

model LessonCell {
  id       String         @id @default(cuid())
  lessonId String
  lesson   Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  position Int
  type     LessonCellType
  title    String?

  // TEXT cells render this as lesson notes / rich text.
  textContent String?

  // CODE_TASK cells use these fields for the prompt, editor starter, examples,
  // test cases, and lint settings. The app validates each JSON shape by type.
  taskPrompt  String?
  starterCode String?
  examples    Json?
  testCases   Json?
  lintConfig  Json?

  quiz     Quiz?                @relation("CellQuiz")
  progress LessonCellProgress[]
  submissions CodeSubmission[]
  quizAttempts QuizAttempt[]
  activityHeartbeats LearningActivityHeartbeat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, position])
  @@index([lessonId, type])
  @@map("lesson_cell")
}

model LessonCellProgress {
  id           String           @id @default(cuid())
  userId       String
  lessonCellId String
  status       LessonCellStatus @default(LOCKED)
  attempts     Int              @default(0)
  passedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonCell LessonCell @relation(fields: [lessonCellId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonCellId])
  @@index([userId, status])
  @@index([lessonCellId, status])
  @@map("lesson_cell_progress")
}

enum CodeSubmissionStatus {
  ACCEPTED
  WRONG_ANSWER
  LINT_ERROR
  RUNTIME_ERROR
  TIME_LIMIT
  SYSTEM_ERROR
}

model CodeSubmission {
  id           String               @id @default(cuid())
  userId       String
  lessonCellId String
  sourceCode   String
  status       CodeSubmissionStatus
  passedTests  Int                  @default(0)
  totalTests   Int                  @default(0)
  actualOutput String?
  errorText    String?
  lintOutput   String?
  durationMs   Int                  @default(0)
  createdAt    DateTime             @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonCell LessonCell @relation(fields: [lessonCellId], references: [id], onDelete: Cascade)
  feedback   SubmissionFeedback?

  @@index([userId, lessonCellId, createdAt])
  @@index([userId, status, createdAt])
  @@map("code_submission")
}

enum LearningActivityKind {
  READING
  SOLVING
}

model LearningActivityHeartbeat {
  id            String              @id @default(cuid())
  eventId       String              @unique
  userId        String
  lessonCellId  String
  kind          LearningActivityKind
  activeSeconds Int
  occurredAt    DateTime            @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonCell LessonCell @relation(fields: [lessonCellId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@map("learning_activity_heartbeat")
}

model StudentDailyActivity {
  id               String   @id @default(cuid())
  userId           String
  day              DateTime @db.Date
  readingSeconds   Int      @default(0)
  solvingSeconds   Int      @default(0)
  codeSubmissions  Int      @default(0)
  acceptedTasks    Int      @default(0)
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId, day])
  @@map("student_daily_activity")
}

model Quiz {
  id        String         @id @default(cuid())
  lessonId  String?        @unique
  lesson    Lesson?        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  cell      LessonCell?    @relation("CellQuiz", fields: [cellId], references: [id], onDelete: Cascade)
  cellId    String?        @unique
  questions QuizQuestion[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model QuizAttempt {
  id String @id @default(cuid())
  userId String
  lessonCellId String
  // Snapshot keyed by question id; values are selected answer ids only.
  selectedAnswers Json
  score Int
  total Int
  passed Boolean
  submittedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonCell LessonCell @relation(fields: [lessonCellId], references: [id], onDelete: Cascade)
  feedback SubmissionFeedback?
  @@index([userId, lessonCellId, submittedAt])
  @@map("quiz_attempt")
}

model SubmissionFeedback {
  id String @id @default(cuid())
  codeSubmissionId String? @unique
  quizAttemptId String? @unique
  reviewerId String
  score Int
  comment String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  codeSubmission CodeSubmission? @relation(fields: [codeSubmissionId], references: [id], onDelete: Cascade)
  quizAttempt QuizAttempt? @relation(fields: [quizAttemptId], references: [id], onDelete: Cascade)
  reviewer User @relation("FeedbackReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  @@index([reviewerId, createdAt])
  @@map("submission_feedback")
}

model QuizQuestion {
  id       String           @id @default(cuid())
  quizId   String
  quiz     Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text     String
  type     QuizQuestionType
  position Int
  answers  QuizAnswer[]

  @@unique([quizId, position])
  @@index([quizId])
}

model QuizAnswer {
  id          String       @id @default(cuid())
  questionId  String
  question    QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text        String
  isCorrect   Boolean      @default(false)
  explanation String?
  position    Int

  @@index([questionId])
}

model ContactMessage {
  id String @id @default(cuid())

  name    String
  email   String
  message String

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("contact_message")
}

model Enrollment {
  id String @id @default(cuid())

  amount     Int
  status     EnrollmentStatus @default(Pending)
  accessMode CourseAccessMode @default(ALL_AT_ONCE)
  dueAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([userId, courseId])
  @@index([createdAt])
  @@index([courseId, dueAt])
}

model CourseInvitation {
  id String @id @default(cuid())
  courseId String
  email String
  tokenHash String @unique
  accessMode CourseAccessMode @default(ALL_AT_ONCE)
  dueAt DateTime?
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime @default(now())
  createdById String
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy User @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  @@index([courseId, email])
  @@index([expiresAt])
  @@map("course_invitation")
}

model LearningCursor {
  userId String
  courseId String
  lessonId String
  cellId String?
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@id([userId, courseId])
  @@index([courseId, updatedAt])
  @@map("learning_cursor")
}

enum StudentNotificationType {
  COURSE_ASSIGNED
  COURSE_DUE_SOON
  COURSE_OVERDUE
}

model StudentNotification {
  id String @id @default(cuid())
  userId String
  courseId String
  type StudentNotificationType
  title String
  body String
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
  @@unique([userId, courseId, type])
  @@map("student_notification")
}

enum EnrollmentStatus {
  Pending
  Active
  Cancelled
}

enum CourseAccessMode {
  ALL_AT_ONCE
  SEQUENTIAL
}

// Records processed Stripe webhook event IDs so replayed events are no-ops.
model ProcessedWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@map("processed_webhook_event")
}

enum QuizQuestionType {
  SINGLE
  MULTIPLE
}

model LessonProgress {
  id String @id @default(cuid())

  completed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId String

  @@unique([userId, lessonId])
}

model LessonComment {
  id        String   @id @default(cuid())
  content   String
  isEdited  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  parentId String?
  parent   LessonComment?  @relation("LessonCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  LessonComment[] @relation("LessonCommentReplies")

  likes LessonCommentLike[]

  @@index([lessonId, parentId, createdAt])
  @@index([userId])
  @@map("lesson_comment")
}

model LessonCommentLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  commentId String
  comment   LessonComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
  @@map("lesson_comment_like")
}

model CourseReview {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  isEdited  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId, createdAt])
  @@index([userId])
  @@map("course_review")
}

model WishlistItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId, createdAt])
  @@index([courseId])
  @@map("wishlist_item")
}

model PendingUpload {
  key       String   @id
  userId    String
  courseId  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("pending_upload")
}

model Certificate {
  id               String @id @default(cuid())
  verificationCode String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  // Stable copy of the course id at issue time. `courseId` goes NULL when a
  // course is deleted, and Postgres treats NULLs as distinct in unique indexes,
  // so this is what actually enforces one certificate per (user, course).
  courseIdSnapshot String

  // Snapshot fields — fallback ONLY when the course is deleted (course becomes null).
  // The public page prefers live course data; these are insurance against deletion.
  courseTitleSnapshot    String
  courseSlugSnapshot     String
  levelSnapshot          CourseLevel
  durationSnapshot       Int
  instructorNameSnapshot String
  lessonsCountSnapshot   Int

  recipientName String
  issuedAt      DateTime @default(now())

  @@unique([userId, courseId])
  @@unique([userId, courseIdSnapshot])
  @@index([verificationCode])
  @@index([userId, issuedAt])
  @@index([courseId])
  @@map("certificate")
}
